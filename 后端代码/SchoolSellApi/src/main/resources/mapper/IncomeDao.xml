<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xuyan.fm.dao.IncomeDao">
    <resultMap id="chartMap" type="hashmap">
        <result property="categoryId" column="idle_label"></result>
        <result property="categoryName" column="category_name"></result>
        <result property="categoryIncome" column="category_income"></result>
    </resultMap>
    <select id="selectCategoryIncome" resultMap="chartMap">
        select payment_status,idle_label,sh_type.name as category_name,SUM(idle_price) as category_income  from sh_order,sh_idle_item,sh_type
        where sh_idle_item.idle_label = sh_type.id AND sh_order.payment_status = 1  AND sh_order.idle_id = sh_idle_item.id GROUP BY idle_label
    </select>
    <select id="selectSumIncome" resultType="decimal">
        select sum(idle_price)  from sh_idle_item
    </select>
</mapper>